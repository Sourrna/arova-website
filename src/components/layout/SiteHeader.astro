---
import { navigation } from "../../data/navigation";

---
<header class="sticky top-0 z-[50] border-b border-transparent transition-colors" aria-label="سربرگ">
  <div class="container flex items-center justify-between px-4 py-4">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2">
        <img src="/images/logo/arova-symbol.svg" alt="" width="32" height="32" class="block" aria-hidden="true" />
        <span class="text-xl font-bold tracking-tight text-[#141414]">AROVA</span>
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-8 text-base font-medium">
      {navigation.map((item: import("../../data/navigation").NavItem) => (
        <a
          
          href={item.href}
          class={`transition-colors hover:text-[#5B1E2D] ${item.isCta ? 'px-5 py-2.5 rounded-md border border-[#141414] text-[#141414] hover:bg-[#141414] hover:text-white' : 'text-[#141414]'}`}
        >
          {item.label}
        </a>
      ))}
      <span class="text-sm text-[#92949A]">FA</span>
    </nav>

    <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-md hover:bg-[#F2EFE9] transition-colors" aria-label="باز کردن منو" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>


