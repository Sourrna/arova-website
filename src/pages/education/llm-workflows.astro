---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";
import PrimaryButton from "../../components/ui/PrimaryButton.astro";
---

<BaseLayout title="ورکشاپ پرومپتینگ و ورک‌فلو LLM | AROVA" description="استفاده عملیاتی از مدل‌های زبانی بزرگ، پرومپتینگ ساختاریافته، تقسیم کار، طراحی ورک‌فلو و ارزیابی." canonical="/education/llm-workflows">
  <section class="section">
    <div class="container">
      <SectionHeading title="ورکشاپ پرومپتینگ و ورک‌فلو LLM" subtitle="طراحی پرومپت‌های ساختاریافته، تقسیم کار و ساخت ورک‌فلوهای LLM." align="center" />
      <div class="grid lg:grid-cols-3 gap-8 mt-10">
        <div class="lg:col-span-2 space-y-8">
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white">
            <h3 class="text-lg font-semibold mb-4">جمهور الهدف</h3>
            <p class="text-[#92949A] leading-relaxed">متخصصان، مدیران و تیم‌های فنی</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white">
            <h3 class="text-lg font-semibold mb-4">نتایج آموزشی</h3>
            <ul class="list-disc list-inside text-[#92949A] leading-relaxed space-y-2">
              <li>طراحی پرومپت‌های ساختاریافته</li>
              <li>تقسیم کارهای پیچیده به زیرکارها</li>
              <li>ساخت ورک‌فلوهای LLM</li>
            </ul>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white">
            <h3 class="text-lg font-semibold mb-4">پیش‌نیازها</h3>
            <p class="text-[#92949A] leading-relaxed">آشنایی پایه با مفاهیم هوش مصنوعی</p>
          </div>
        </div>
        <div class="lg:col-span-1 space-y-6">
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white">
            <h3 class="text-lg font-semibold mb-4">جزئیات اجرا</h3>
            <p class="text-[#92949A] text-sm leading-relaxed"><span class="font-semibold">مدت:</span> ۶ ساعت</p>
            <p class="text-[#92949A] text-sm leading-relaxed"><span class="font-semibold">قالب:</span> حضور یا آنلاین</p>
            <p class="text-[#92949A] text-sm leading-relaxed"><span class="font-semibold">مربیان:</span> سورنا</p>
            <p class="text-[#92949A] text-sm leading-relaxed"><span class="font-semibold">سازمانی:</span> ندارد</p>
          </div>
          <div class="p-6 rounded-lg border border-[#5B1E2D] bg-[#5B1E2D] text-white">
            <h3 class="text-lg font-semibold mb-4">ثبت‌نام</h3>
            <PrimaryButton label="درخواست کارگاه" href="/contact" variant="ghost" class="w-full" />
          </div>
        </div>
      </div>
      <p class="mt-8 text-sm text-[#92949A] text-center">تاریخ، روش ارائه و قیمت هر برنامه با سازمان تایید می‌شود.</p>
    </div>
  </section>
</BaseLayout>
