---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";
import PrimaryButton from "../../components/ui/PrimaryButton.astro";
---

<BaseLayout title="تجربه وب و طراحی UI | AROVA" description="طراحی تجربه وب، پیاده‌سازی Frontend و کاوش محصول دیجیتال." canonical="/digital-solutions/web-experience">
  <section class="section">
    <div class="container">
      <SectionHeading title="تجربه وب و طراحی UI" subtitle="پیاده‌سازی Frontend و کاوش محصول دیجیتال" align="center" />
      <div class="grid lg:grid-cols-2 gap-12 mt-10">
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">1.</span>
            <p class="text-[#92949A] leading-relaxed">طراحی تجربه کاربری وب‌سایت</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">2.</span>
            <p class="text-[#92949A] leading-relaxed">پیاده‌سازی Frontend</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">3.</span>
            <p class="text-[#92949A] leading-relaxed">کاوش محصول دیجیتال و پروتوتایپینگ</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">4.</span>
            <p class="text-[#92949A] leading-relaxed">طراحی ورک‌فلوهای AI</p>
          </div>
        </div>
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#5B1E2D] bg-[#5B1E2D] text-white">
            <h3 class="text-lg font-semibold mb-4">محدودیت‌ها و شرایط</h3>
            <p class="text-[#F2EFE9] leading-relaxed">محدوده و تیم وsuppیments دستکار با نیاز مشتری تعریف می‌شود.</p>
          </div>
          <PrimaryButton label="گفت‌وگو درباره پروژه" href="/contact" variant="primary" class="w-full" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
