---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";
import PrimaryButton from "../../components/ui/PrimaryButton.astro";
---

<BaseLayout title="استراتژی هوش مصنوعی | AROVA" description="مرور فرصت‌های هوش مصنوعی، بررسی آمادگی، اولویت‌بندی Use Caseها، آگاهی از governance و ریسک، و راه‌مانند اجرا." canonical="/advisory/ai-strategy">
  <section class="section">
    <div class="container">
      <SectionHeading title="استراتژی هوش مصنوعی" subtitle="مشاوره استراتژیک و فنی در زمینة هوش مصنوعی" align="center" />
      <div class="grid lg:grid-cols-2 gap-12 mt-10">
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">1.</span>
            <p class="text-[#92949A] leading-relaxed">مرور فرصت‌های هوش مصنوعی در سازمان</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">2.</span>
            <p class="text-[#92949A] leading-relaxed">بررسی آمادگی سازمانی برای گنجاندن AI</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">3.</span>
            <p class="text-[#92949A] leading-relaxed">اولویت‌بندی Use Caseها</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">4.</span>
            <p class="text-[#92949A] leading-relaxed">آگاهی از governance و ریسک‌ها</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">5.</span>
            <p class="text-[#92949A] leading-relaxed">راه‌مانند اجرا</p>
          </div>
        </div>
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#5B1E2D] bg-[#5B1E2D] text-white">
            <h3 class="text-lg font-semibold mb-4">محدودیت‌ها و شرایط</h3>
            <p class="text-[#F2EFE9] leading-relaxed">هدف، محدودیت‌ها و راه‌مانند نهایی برای هر مشتری پس از بحث اولیه تعریف می‌شود.</p>
          </div>
          <PrimaryButton label="درخواست مشاوره" href="/contact" variant="primary" class="w-full" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
