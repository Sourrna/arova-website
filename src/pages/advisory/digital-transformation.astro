---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";
import PrimaryButton from "../../components/ui/PrimaryButton.astro";
---

<BaseLayout title="تحويل دیجیتال | AROVA" description="تحويل سازمانی و فنی نه صرف خرید نرم‌افزار. تأکید بر فرآیند، داده، افراد، سیستم‌ها و امکان‌پذیری اجرا." canonical="/advisory/digital-transformation">
  <section class="section">
    <div class="container">
      <SectionHeading title="تحويل دیجیتال" subtitle="مشاوره تحول دیجیتال سازمانی" align="center" />
      <div class="grid lg:grid-cols-2 gap-12 mt-10">
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">1.</span>
            <p class="text-[#92949A] leading-relaxed">تحلیل وضعیت فعلی سازمان</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">2.</span>
            <p class="text-[#92949A] leading-relaxed">تعریف مسیر تحولی</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">3.</span>
            <p class="text-[#92949A] leading-relaxed">بهینه‌سازی فرآیندها و سیستم‌ها</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">4.</span>
            <p class="text-[#92949A] leading-relaxed">تغییر مدیریت و آموزش</p>
          </div>
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white flex items-start gap-3">
            <span class="text-[#5B1E2D] font-bold mt-0.5">5.</span>
            <p class="text-[#92949A] leading-relaxed">ارزیابی امکان‌پذیری فنی</p>
          </div>
        </div>
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#5B1E2D] bg-[#5B1E2D] text-white">
            <h3 class="text-lg font-semibold mb-4">محدودیت‌ها و شرایط</h3>
            <p class="text-[#F2EFE9] leading-relaxed">مدت کم برای هر مشتری بر اساس سایز و نیازها تعیین می‌شود.</p>
          </div>
          <PrimaryButton label="درخواست مشاوره" href="/contact" variant="primary" class="w-full" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
