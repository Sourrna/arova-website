---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";
---

<BaseLayout title="دکتر محمدحسین روزبهانی | AROVA" description="پروفایل آکادمیک و پژوهشی" canonical="/experts/dr-mohammad-hossein-roozbahani">
  <section class="section">
    <div class="container">
      <SectionHeading title="دکتر محمدحسین روزبهانی" subtitle="پروفایل آکادمیک و پژوهشی" align="center" />
      <div class="grid lg:grid-cols-2 gap-12 items-start mt-10">
        <div>
          <div class="w-24 h-24 rounded-full bg-[#5B1E2D] flex items-center justify-center text-white font-bold text-2xl mb-6">م</div>
          <h1 class="text-4xl font-bold mb-4">دکتر محمدحسین روزبهانی</h1>
          <p class="text-lg text-[#5B1E2D] font-medium mb-6">پروفایل آکادمیک و پژوهشی</p>
          <p class="text-lg text-[#92949A] leading-relaxed mb-8">
            پروفایل کامل در انتظار تأیید منبع (CV). جزئیات تحصیلی، پژوهشی و حرفه‌ای تنها پس از تأیید منتشر خواهند شد.
          </p>
          <h3 class="text-lg font-semibold mb-3">حوزه‌های فعالیت</h3>
          <ul class="list-disc list-inside text-[#92949A] leading-relaxed space-y-2 mb-8">
            <li>پیشینه آکادمیک و پژوهشی (در انتظار تأیید)</li>
            <li>تدریس و انتقال دانش (در انتظار تأیید)</li>
            <li>مشاوره علمی و تحلیلی (در انتظار تأیید)</li>
          </ul>
        </div>
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white">
            <h3 class="text-lg font-semibold mb-4">نمایه</h3>
            <p class="text-[#92949A] leading-relaxed">پروفایل کامل در انتظار تأیید منبع. فیلدهای CMS به صورت پیش‌نویس نگهداری می‌شوند.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
