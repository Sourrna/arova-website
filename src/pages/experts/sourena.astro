---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/layout/SectionHeading.astro";
---

<BaseLayout title="سورنا | AROVA" description="محصول و تجربه کاربری دیجیتال | هوش مصنوعی کاربردی" canonical="/experts/sourena">
  <section class="section">
    <div class="container">
      <SectionHeading title="سورنا" subtitle="محصول و تجربه کاربری دیجیتال | هوش مصنوعی کاربردی" align="center" />
      <div class="grid lg:grid-cols-2 gap-12 items-start mt-10">
        <div>
          <div class="w-24 h-24 rounded-full bg-[#5B1E2D] flex items-center justify-center text-white font-bold text-2xl mb-6">س</div>
          <h1 class="text-4xl font-bold mb-4">سورنا</h1>
          <p class="text-lg text-[#5B1E2D] font-medium mb-6">محصول و تجربه کاربری دیجیتال | هوش مصنوعی کاربردی</p>
          <p class="text-lg text-[#92949A] leading-relaxed mb-8">
            تمرکز بر فکر محصول، تجربه کاربری دیجیتال و کارگاه‌های کاربردی هوش مصنوعی. جزئیات پروفایل کامل در انتظار تأیید منبع است.
          </p>
          <h3 class="text-lg font-semibold mb-3">حوزه‌های فعالیت</h3>
          <ul class="list-disc list-inside text-[#92949A] leading-relaxed space-y-2 mb-8">
            <li>فکر محصول و تجربه کاربری دیجیتال</li>
            <li>پیاده‌سازی رابط کاربری (frontend)</li>
            <li>آموزش هوش مصنوعی و ورک‌فلوهای کاربردی LLM</li>
            <li>طراحی تجربه یادگیری</li>
          </ul>
        </div>
        <div class="space-y-6">
          <div class="p-6 rounded-lg border border-[#BFC1C5] bg-white">
            <h3 class="text-lg font-semibold mb-4">نمایه</h3>
            <p class="text-[#92949A] leading-relaxed">پروفایل کامل در انتظار تأیید منبع. فیلدهای CMS به صورت پیش‌نویس نگهداری می‌شوند.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
