# AROVA Environment Variables
# Copy this file to .env and fill in actual values before deployment.

# Canonical production site URL (used for SEO canonical tags and sitemap)
PUBLIC_SITE_URL=https://arova.example.com

# CMS endpoint for build-time content retrieval (optional)
# Default: http://localhost:4000
# PUBLIC_CMS_URL=http://localhost:4000

# Form provider configuration (optional)
# Configure only when a form endpoint is available.
# Leave unset to use the built-in mailto fallback.
# FORM_PROVIDER_ENDPOINT=
# FORM_PROVIDER_API_KEY=
